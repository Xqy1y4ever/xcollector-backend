# ============================================================
# Xcollector backend 配置示例
# 复制为 .env 后按需修改。所有项都有默认值，缺 .env 也能启动。
#
# 本服务是**纯数据层**：只做存储与增删查改，不做任何业务判断。
# QQ 连接、群/发送者筛选、抽取、digest 组装与发送全部在 xcollector-bot 里，
# 所以那些配置（ONEBOT_*、白名单、LLM_*、VLM_*、DIGEST_*）都不在这个文件里 ——
# 后端放一个自己永远不读的配置项，只会让人改了之后困惑为什么没生效。
#
# 接口契约见 docs/api.md。
# ============================================================

# ---------------- 认证 ----------------
# **两个范围：服务令牌 / 用户令牌。**
#
# API_TOKEN —— **服务令牌**。只有 bot 有，**永远不要给浏览器**。
#   它能跨用户读写所有人的数据（入库、建条、删通知、发验证码、发邀请码），
#   所以泄露的后果是整个服务。bot 侧的配置项刻意同名，不需要猜对应关系。
#   留空 = 不校验任何请求（仅限本地开发，启动时会打 WARNING）。
#
# 用户令牌（UserToken）**不在这里配**：每个用户注册时各自签发一个，
# 库里只存 sha256。它绑定到具体的 user_id，只能碰自己的数据。
# 前端登录页输的就是它。
#
# 生产部署：只填 API_TOKEN（backend/.env 与 bot/.env 同一个值）。
#   生成：python -c "import secrets;print(secrets.token_hex(32))"
API_TOKEN=

# ---------------- 注册 ----------------
# invite = 需要邀请码（默认，推荐）。运营者用 API_TOKEN 调
#          POST /api/invites 签发，把 code 发给被邀请的人。
# open   = 开放注册：任何能通过 QQ 验证的人都能注册。
#          ⚠️ 每次注册都意味着别人可以花你的 LLM 额度、占用你的存储。
SIGNUP_MODE=invite
# QQ 验证码有效期（秒）
VERIFY_CODE_TTL=600
# 验证码最多允许猜错几次，超过直接作废（防暴力猜 6 位码）
VERIFY_MAX_ATTEMPTS=5
# 是否允许已有用户再走一次「QQ 要码 → 网页提交」来轮换令牌。
# 令牌只存摘要、丢了拿不回来，所以默认开着。
ALLOW_TOKEN_ROTATION=true

# ---------------- 附件签名 URL ----------------
# 浏览器用 <img src> / <a href> 取附件时**带不了 Authorization 头**，
# 所以读投影里的附件 url 是现签的：/api/attachments/xxx?exp=...&sig=...
# 下载接口接受"有效签名"或"有效 Bearer"任一。
#
# 有效期（秒）。太长等于长期有效的裸链接，太短会让打开很久的页面图裂。
# 0 = 不签名，退回"下载必须带 Bearer"（那样 <img> 会 401）。
ATTACHMENT_URL_TTL=3600
# 签名密钥。留空 = 从 API_TOKEN 派生，通常不用配。
# 想单独轮换附件链接而不动登录令牌时才设它。
ATTACHMENT_SIGN_KEY=

# ---------------- 存储 ----------------
DB_PATH=data/xcollector.db
# 附件二进制目录；库里只存元数据
ATTACHMENT_DIR=data/attachments
# 单个附件的字节上限，超限上传返回 413
MEDIA_MAX_BYTES=5242880

# ---------------- HTTP 服务 ----------------
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------- 日志 ----------------
# 写接口的 INFO 日志会打印落库动作；DEBUG 还能看到被忽略的越权字段
LOG_LEVEL=INFO
# 日志里文本预览的最大字符数
LOG_PREVIEW_CHARS=60
