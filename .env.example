# ============================================================
# Xcollector backend 配置示例
# 复制为 .env 后按需修改。所有项都有默认值，缺 .env 也能启动。
#
# 本服务是**纯数据层**：只做存储与增删查改，不做任何业务判断。
# QQ 连接、群/发送者筛选、抽取、digest 组装与发送全部在 xcollector-bot 里，
# 所以那些配置（ONEBOT_*、白名单、LLM_*、VLM_*、DIGEST_*）都不在这个文件里 ——
# 后端放一个自己永远不读的配置项，只会让人改了之后困惑为什么没生效。
#
# 接口契约见 docs/api.md。
# ============================================================

# ---------------- 认证 ----------------
# **两个令牌，两个范围。**
#
# API_TOKEN —— 写入令牌。只有 bot 有，**永远不要给浏览器**。
#   所有 /api 请求都要带：Authorization: Bearer <API_TOKEN>。
#   bot 侧的配置项刻意同名（同一个值、同一个名字，不需要猜对应关系）。
#   留空 = 不校验任何请求（仅限本地开发，启动时会打 WARNING）。
#
# WEB_API_TOKEN —— 网页令牌。给前端登录页用。
#   只能：读、提交人工修正、标记已读。
#   不能：入库、建条、改机器字段、删除、上传附件、写 state/stats/digest-log
#        —— 那些一律返回 403（身份有效但没权限，不是 401）。
#
# 为什么要拆（这是重点）：
#   WEB_API_TOKEN 必须交给登录页，所以任何能打开网页、看一眼浏览器存储的人
#   都拿得到它。如果它和 API_TOKEN 是同一个值，那个人就能伪造入库、删通知。
#   拆开之后，泄露网页令牌最多只能读（+标注），改不了库。
#
# **留空 = 退回单令牌模式**：API_TOKEN 同时充当网页令牌，也就是拆分之前的行为。
# 已有部署不改配置也能跑，但那样就没有分级 —— 启动日志会明确警告。
#
# 生产部署：
#   API_TOKEN     随机串，只填进 backend/.env 和 bot/.env，别外传
#   WEB_API_TOKEN 另**一个**随机串，填进 backend/ bot/ 和前端登录页
#   生成：python -c "import secrets;print(secrets.token_hex(32))"
API_TOKEN=
WEB_API_TOKEN=

# ---------------- 附件签名 URL ----------------
# 浏览器用 <img src> / <a href> 取附件时**带不了 Authorization 头**，
# 所以读投影里的附件 url 是现签的：/api/attachments/xxx?exp=...&sig=...
# 下载接口接受"有效签名"或"有效 Bearer"任一。
#
# 有效期（秒）。太长等于长期有效的裸链接，太短会让打开很久的页面图裂。
# 0 = 不签名，退回"下载必须带 Bearer"（那样 <img> 会 401）。
ATTACHMENT_URL_TTL=3600
# 签名密钥。留空 = 从 API_TOKEN 派生，通常不用配。
# 想单独轮换附件链接而不动登录令牌时才设它。
ATTACHMENT_SIGN_KEY=

# ---------------- 存储 ----------------
DB_PATH=data/xcollector.db
# 附件二进制目录；库里只存元数据
ATTACHMENT_DIR=data/attachments
# 单个附件的字节上限，超限上传返回 413
MEDIA_MAX_BYTES=5242880

# ---------------- HTTP 服务 ----------------
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------- 日志 ----------------
# 写接口的 INFO 日志会打印落库动作；DEBUG 还能看到被忽略的越权字段
LOG_LEVEL=INFO
# 日志里文本预览的最大字符数
LOG_PREVIEW_CHARS=60
