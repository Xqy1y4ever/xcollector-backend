# ============================================================
# Xcollector backend 配置示例
# 复制为 .env 后按需修改。所有项都有默认值，最小可用只需改
# ONEBOT_MODE / GROUP_WHITELIST / DIGEST_TARGET_QQ 三处。
# ============================================================

# ---------------- OneBot 连接 ----------------
# client = 本服务主动连 NapCat 的 WS 地址（NapCat 里配置「WebSocket 服务」）
# server = 本服务开一个 WS 端口，等 NapCat 连过来（NapCat 里配置「反向 WebSocket」）
ONEBOT_MODE=client

# ONEBOT_MODE=client 时使用
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_ACCESS_TOKEN=

# ONEBOT_MODE=server 时使用
ONEBOT_LISTEN_HOST=0.0.0.0
ONEBOT_LISTEN_PORT=8081
ONEBOT_LISTEN_PATH=/onebot/ws

# ---------------- 白名单（群 × 发送者）----------------
# 格式：id:名称,id:名称   （名称可省略，只写 id 也行）
# 只有白名单内群的消息会被抽取；白名单外群的消息不接收（群列表里也不显示）
GROUP_WHITELIST=123456789:NOVA官方通知群

# 留空 = 该群内所有发送者的消息都抽取
# strict = 只有白名单发送者会被抽取，其他人只入库不抽取
SENDER_WHITELIST=10001:李老师,10002:王导
SENDER_WHITELIST_MODE=strict

# ---------------- 抽取 ----------------
# llm = 只用大模型；rule = 只用确定性规则（无需 API key，可离线跑通全链路）；both = 规则先跑，LLM 再覆盖
EXTRACTOR=llm

# LLM 主模型（litellm 的 model 名称）
LLM_PRIMARY_MODEL=deepseek/deepseek-chat
# 交叉验证模型。留空 = 关闭交叉验证。
# 官方通知量很小，建议开启：两个模型对 due_at 的判断不一致时会标红让人确认。
LLM_SECONDARY_MODEL=
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=2
LLM_TIMEOUT=60

# litellm 直接读取各厂商的环境变量，例如：
# DEEPSEEK_API_KEY=sk-xxx
# OPENAI_API_KEY=sk-xxx

# litellm 在导入时会去 raw.githubusercontent.com 拉模型价格表，
# 国内网络下会阻塞导入、后台重试 3 次并刷一串 WARNING（本机实测 87 秒）。
# 我们只用 usage.total_tokens，不需要这张表，所以 app/__init__.py 已默认关掉。
# 一般不用改；确有需要时在这里显式覆盖：
# LITELLM_LOCAL_MODEL_COST_MAP=True
# LITELLM_LOCAL_BLOG_POSTS=True

# 是否把图片发给多模态模型识别（官方通知经常把 DDL 写在图里）
VLM_ENABLED=false
VLM_MAX_IMAGES=3

# ---------------- 每日 digest ----------------
DIGEST_ENABLED=true
DIGEST_TIME=21:30
DIGEST_TZ=Asia/Shanghai
# 接收 digest 的 QQ 号（私聊）
DIGEST_TARGET_QQ=

# ---------------- 存储 ----------------
DB_PATH=data/xcollector.db
ATTACHMENT_DIR=data/attachments
# 图片/文件的 URL 有时效性，必须落地保存，否则过期就取不回来
MEDIA_DOWNLOAD_ENABLED=true
MEDIA_MAX_BYTES=5242880

# ---------------- 告警阈值 ----------------
# 一个群静默超过这么多小时就产生缺口告警
GAP_ALERT_HOURS=2
# due_confidence 低于此值视为「待确认」
LOW_CONFIDENCE_THRESHOLD=0.6

# ---------------- HTTP 服务 ----------------
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 合并转发消息递归展开的最大深度
FORWARD_MAX_DEPTH=3
