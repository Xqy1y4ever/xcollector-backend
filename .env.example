# ============================================================
# Xcollector backend 配置示例
# 复制为 .env 后按需修改。所有项都有默认值，缺 .env 也能启动。
#
# 本服务是**纯数据层**：只做存储与增删查改，不做任何业务判断。
# QQ 连接、群/发送者筛选、抽取、digest 组装与发送全部在 xcollector-bot 里，
# 所以那些配置（ONEBOT_*、白名单、LLM_*、VLM_*、DIGEST_*）都不在这个文件里 ——
# 后端放一个自己永远不读的配置项，只会让人改了之后困惑为什么没生效。
#
# 接口契约见 docs/api.md。
# ============================================================

# ---------------- 认证 ----------------
# **整套系统只有这一个共享密钥。**
#
# bot 调后端的每个请求都要带：Authorization: Bearer <API_TOKEN>
# bot 侧的配置项刻意也叫 API_TOKEN（同一个值、同一个名字，不需要猜对应关系）。
# 留空 = 不校验任何请求（仅限本地开发，启动时会打 WARNING）。
#
# 生产部署：填一个随机串，backend/.env 与 bot/.env 填**同一个值**。
API_TOKEN=

# ---------------- 存储 ----------------
DB_PATH=data/xcollector.db
# 附件二进制目录；库里只存元数据
ATTACHMENT_DIR=data/attachments
# 单个附件的字节上限，超限上传返回 413
MEDIA_MAX_BYTES=5242880

# ---------------- HTTP 服务 ----------------
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------- 日志 ----------------
# 写接口的 INFO 日志会打印落库动作；DEBUG 还能看到被忽略的越权字段
LOG_LEVEL=INFO
# 日志里文本预览的最大字符数
LOG_PREVIEW_CHARS=60
